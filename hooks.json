{
  "antigravity-pulse-telemetry": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/telemetry-hook.mjs PreInvocation",
        "timeout": 5
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/telemetry-hook.mjs PostInvocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/telemetry-hook.mjs Stop",
        "timeout": 5
      }
    ]
  }
}
